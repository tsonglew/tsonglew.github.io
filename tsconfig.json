{
  "extends": "astro/tsconfigs/strict",
  "include": ["./.astro/types.d.ts", "./**/*"],
  "compilerOptions": {
    // Basic
    "allowJs": true,
    // NOTE: `declaration` was removed — this is a blog (site project), not a
    // library, so no .d.ts files are emitted or consumed. Keeping it on makes
    // `astro check` fail with ts(2883) for configs that use the local font
    // provider, whose inferred type references astro-internal types that can't
    // be named in declaration files.
    // Code runs in the DOM
    "lib": ["es2022", "dom", "dom.iterable"],
    // Type Imports
    "verbatimModuleSyntax": true,
    // Others
    "strictNullChecks": true,
    // Paths
    "paths": {
      "@/assets/*": ["./src/assets/*"],
      "@/public/*": ["./public/*"],
      "@/components/*": ["./src/components/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/utils": ["./src/utils/index.ts"],
      "@/utils/*": ["./src/utils/*"],
      "@/plugins/*": ["./src/plugins/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/types": ["./src/types/index.ts"],
      "@/site-config": ["./src/site.config.ts"]
    }
  },
  "exclude": ["./node_modules", "./**/node_modules/*", "./.vscode", "./dist", "./public/scripts/*", "./test/*"]
}
